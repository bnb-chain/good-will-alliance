# Copy to .env and fill in. `.env` is git-ignored. Load with: source .env
# Never put a private key in this file; use `cast wallet import` (see README).

# RPC endpoints referenced by [rpc_endpoints] in foundry.toml
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com

# For `--verify` / `forge verify-contract`
BSCSCAN_API_KEY=

# Deploy.s.sol
OWNER=0x0000000000000000000000000000000000000000   # multisig / admin that will own the registry
DEFAULT_MAX_KEYS=7                                  # >= largest per-builder count in the initial list; lower to 4 later
BUILDERS_JSON=script/input/bsc-mainnet/builders.json

# Upgrade.s.sol
PROXY=
