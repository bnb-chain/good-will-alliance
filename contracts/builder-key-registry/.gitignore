# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Generated docs; keep the maintained usage guide in version control.
docs/*
!docs/usage.md

# Dotenv file
.env
.env.*
!.env.example

# Deploy inputs are generated from mev-info/*/builder-list.toml by script/gen-builders.py; do not commit them.
script/input/
